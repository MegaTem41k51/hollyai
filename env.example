# ИИ API
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# PostgreSQL: скопируй Internal Database URL из Render
DATABASE_URL=postgresql://user:password@host:5432/database
# Render PostgreSQL обычно использует TLS. Для локальной БД можно поставить false:
DATABASE_SSL=false

# Секрет сессий: сгенерируй длинную случайную строку
SESSION_SECRET=replace_with_a_long_random_secret

# Google OAuth credentials из Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

PORT=3000
NODE_ENV=development
